data:
  data:
    nginx:
      customConfigDir: {{ .chezmoi.homeDir }}/.config/nginx
      {{ if eq .chezmoi.os "darwin" -}}
      installConfigDir: /opt/homebrew/etc/nginx
      {{- else if eq .chezmoi.os "linux" -}}
      installConfigDir: /usr/local/nginx/conf
      {{- else if eq .chezmoi.os "windows" -}}
      prefixPath: {{ .chezmoi.homeDir }}/scoop/apps/nginx/current
      installConfigDir: {{ .chezmoi.homeDir }}/scoop/apps/nginx/current/conf
      {{- end }}
